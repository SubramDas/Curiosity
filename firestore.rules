// Backend-only public metadata, cache index/leases and daily usage counters.
// User accounts and private learning records remain in Supabase.
// Server access uses Cloud Run IAM; web/mobile clients receive no Firestore access.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
