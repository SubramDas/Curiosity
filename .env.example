# Local Phase 2 tests only. Copy to .env; do not commit or share .env.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Choose a text model that your account explicitly lists as available on Free.
GEMINI_MODEL=
# Set true only after reading the prototype data-use notes in PHASE_2_SETUP.md.
ALLOW_GEMINI_FREE_TEST=false
# Supabase development project; no privileged key required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Local prototype limits. No automatic paid upgrades.
SEARCH_DAILY_LIMIT=40
CHAT_DAILY_LIMIT=25
