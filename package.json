{
  "name": "learning-app-feasibility",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark": "node experiments/benchmarks/run.mjs",
    "test": "node experiments/phase-2/tests/services.test.mjs && tsx --test tests/*.test.ts",
    "dev": "node --env-file=.env backend/dev.mjs",
    "dev:lan": "node --env-file=.env backend/dev.mjs --lan",
    "start": "node backend/production.mjs",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "phase2:check": "node experiments/phase-2/run.mjs check",
    "phase2:search": "node --env-file=.env experiments/phase-2/run.mjs search",
    "phase2:chat": "node --env-file=.env experiments/phase-2/run.mjs chat",
    "phase2:review-chat": "node --env-file=.env experiments/phase-2/review-chat.mjs",
    "phase2:check-config": "node --env-file=.env experiments/phase-2/run.mjs check",
    "phase2:teacher-check": "node experiments/phase-2/check-teacher.mjs",
    "phase2:classify": "node experiments/phase-2/check-classification.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "@supabase/supabase-js": "2.109.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
